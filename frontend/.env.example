# Base URL of the backend API
# In local development: http://127.0.0.1:8000
# On VPS with reverse proxy (recommended): leave empty or use http://YOUR_VPS_IP:8000 or https://monitor.yourdomain.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# LocalStorage key to store JWT auth token
VITE_TOKEN_KEY=monitoring_token
