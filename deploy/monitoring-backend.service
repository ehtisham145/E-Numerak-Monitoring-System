[Unit]
Description=E-Numerak Monitoring System Backend (FastAPI + Uvicorn)
After=network.target

[Service]
Type=simple
# Change to the linux user who owns the project on your VPS (e.g. ubuntu, root, www-data)
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/E-Numerak-Monitoring-System/backend
Environment="PATH=/var/www/E-Numerak-Monitoring-System/backend/venv/bin"
ExecStart=/var/www/E-Numerak-Monitoring-System/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2

Restart=always
RestartSec=5
StandardOutput=append:/var/log/monitoring-backend.log
StandardError=append:/var/log/monitoring-backend.error.log

[Install]
WantedBy=multi-user.target
